# Copy this file to .env and fill in whichever keys you have.
# You don't need all three — llm-bridge skips any provider with no key set.

# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only needed if your key is an org-level key (not scoped to one workspace).
# You'll see this in an error like: "This API key is not scoped to a workspace..."
# Find the workspace ID in the Console under Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=

# Get from https://platform.openai.com
OPENAI_API_KEY=

# Get from https://console.x.ai
XAI_API_KEY=

# Optional: override default models
# CLAUDE_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o
# GROK_MODEL=grok-4

# Local model via Ollama — no API key or billing needed, enabled by default.
# Defaults: http://localhost:11434, model llama3.2:3b. Only set these to override.
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=llama3.2:3b
# Set to 1 to skip the local provider entirely (e.g. if Ollama isn't running)
# LOCAL_DISABLED=1

# Optional: silence the post-install donate message
# LLM_BRIDGE_NO_DONATE=1
