# Copy this file to .env and fill in whichever keys you have.
# You don't need all three — llm-bridge skips any provider with no key set.

# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get from https://platform.openai.com
OPENAI_API_KEY=

# Get from https://console.x.ai
XAI_API_KEY=

# Optional: override default models
# CLAUDE_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o
# GROK_MODEL=grok-4

# Optional: silence the post-install donate message
# LLM_BRIDGE_NO_DONATE=1
